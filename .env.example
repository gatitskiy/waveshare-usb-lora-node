# Copy this file to .env and adjust values for your host.
# docker compose auto-loads .env from the project root and uses these
# values to substitute ${VAR} references in docker-compose.yml.

# Path to the Waveshare USB-LoRa serial device on the host. The by-id
# symlink is stable across reboots and across changing port order.
WS_NODE_SERIAL=/dev/serial/by-id/usb-WCH.CN_USB_Single_Serial_CHANGE-ME-if00

# Log level for ws-node and ws-ntfy: debug | info | error
LOG_LEVEL=info
